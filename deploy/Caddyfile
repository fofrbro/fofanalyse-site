# Caddy obtient et renouvelle seul les certificats HTTPS.

(securite) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

fofanalyse.com {
	import securite
	encode gzip

	# Site sans script ni ressource externe : politique stricte.
	@site not path /rag/* /acces/*
	header @site Content-Security-Policy "default-src 'self'; script-src 'none'; img-src 'self' data:; style-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"

	# Pages RAG (/rag/) et RAG avec habilitations (/acces/) : le modèle e5
	# tourne dans le navigateur (transformers.js depuis jsDelivr, WebAssembly,
	# fichiers du modèle chez Hugging Face) et interroge l'API de chaque Worker
	# (mêmes adresses que API_EN_LIGNE dans www/rag/rag.js et www/acces/acces.js).
	@rag path /rag/* /acces/*
	header @rag Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'wasm-unsafe-eval'; connect-src 'self' https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co https://*.hf.co https://fofanalyse-rag.fofanalyse.workers.dev https://fofanalyse-acces.fofanalyse.workers.dev; worker-src 'self' blob:; img-src 'self' data:; style-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"

	# Formulaire de contact : petites requêtes seulement.
	handle /api/contact* {
		request_body {
			max_size 32KB
		}
		reverse_proxy contact:8000
	}

	handle {
		root * /srv/site
		file_server
	}
}

www.fofanalyse.com {
	redir https://fofanalyse.com{uri} permanent
}

demo.fofanalyse.com {
	import securite
	encode gzip

	header {
		# La démo peut être intégrée au site fofanalyse.com, pas ailleurs.
		Content-Security-Policy "frame-ancestors 'self' https://fofanalyse.com"
	}

	# La démo n'accepte pas d'upload : seules de petites requêtes JSON.
	request_body {
		max_size 1MB
	}

	reverse_proxy agent:8000
}
